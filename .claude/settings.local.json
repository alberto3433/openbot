{
  "permissions": {
    "allow": [
      "Bash(python -m pytest:*)",
      "Bash(python:*)",
      "Bash(wc:*)",
      "Bash(pip show:*)",
      "Bash(pip install:*)",
      "Bash(alembic:*)",
      "Bash(copy:*)",
      "Bash(del:*)",
      "Bash(git:*)",
      "Bash(curl:*)",
      "Bash(dir:*)",
      "Bash(cmd:*)",
      "Bash(timeout:*)",
      "Bash(sqlite3:*)",
      "Bash(DATABASE_URL=:*)",
      "Bash(grep:*)",
      "Bash(PYTHONPATH=:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "WebSearch",
      "WebFetch(domain:docs.vapi.ai)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:www.zuckersbagels.com)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && git add -A && git diff --cached --quiet || git commit -m \"Auto-commit by Claude Code\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
